# Copy this to .env and fill in your values
# These must also be set in your Vercel project → Settings → Environment Variables

# Your deployed backend URL (e.g. on Railway, Render, Fly.io)
VITE_API_BASE_URL=https://your-backend-api.example.com/api

# TMDB API (required for movie data — get your key at https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
